# mermaid@12 requires katex >= 0.18.2 (GHSA-238p-pmpm-9mq7, high severity),
# but vitepress-plugin-mermaid@2.0.17 (last release, unmaintained) declares an
# outdated peer range of mermaid@"10 || 11" — which blocks katex from updating.
# Runtime works fine with mermaid 12 (verified); relax strict peer checking so
# `npm ci` succeeds on the documented dependency versions.
legacy-peer-deps=true
