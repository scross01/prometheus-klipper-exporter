# vitepress-plugin-mermaid@2.0.17 (last release, unmaintained) declares outdated
# peer ranges — mermaid@"10 || 11" (actual: mermaid 12, required for the katex
# GHSA-238p-pmpm-9mq7 fix) and vitepress@"^1.0.0" (actual: vitepress 2, required
# to pull vite 8/rolldown and clear the esbuild/vite dev-server advisories).
# Both combinations verified working; relax strict peer checking so `npm ci`
# succeeds on the documented dependency versions.
legacy-peer-deps=true
